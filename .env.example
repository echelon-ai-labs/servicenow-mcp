# Local .env for servicenow-mcp
# Copy values from this file into your private .env and NEVER commit real credentials

SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_AUTH_TYPE=api_key  # basic | oauth | api_key | pkce | session

# BASIC
SERVICENOW_USERNAME=your.username
SERVICENOW_PASSWORD=your-password

# OAUTH
SERVICENOW_CLIENT_ID=your-client-id
SERVICENOW_CLIENT_SECRET=your-client-secret
SERVICENOW_TOKEN_URL=https://your-instance.service-now.com/oauth_token.do

# PKCE / SSO (OAuth 2.0 with browser, single sign-on, automatic refresh)
# 1. Register an app at: System OAuth > Application Registry
# 2. Type: "OAuth API endpoint for external clients"
# 3. Redirect URL: http://localhost:9876/callback
# 4. Copy the Client ID below and set SERVICENOW_AUTH_TYPE=pkce
SERVICENOW_PKCE_SCOPES=useraccount
SERVICENOW_PKCE_REDIRECT_PORT=9876

# API KEY
SERVICENOW_API_KEY=your-api-key
SERVICENOW_API_KEY_HEADER=X-UserToken

# SESSION (browser SSO via Playwright - captures cookies + X-UserToken)
# Prerequisite: pip install -e ".[session]" && python -m playwright install chromium
# Use: servicenow-mcp session login   (opens browser for SSO login)
#      servicenow-mcp session status  (checks cache)
#      servicenow-mcp session clear   (clears cache)
SERVICENOW_SESSION_HEADLESS=false
SERVICENOW_SESSION_AUTO_REFRESH=true
SERVICENOW_SESSION_LOGIN_TIMEOUT=180

# Optional
SERVICENOW_TIMEOUT=30
MCP_TOOL_PACKAGE=full
